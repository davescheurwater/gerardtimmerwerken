---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const projectSlug = (id: string) => id.replace(/\.mdx?$/, '');
---

<BaseLayout
	title="Projecten | Willemstein Timmerwerken"
	description="Bekijk afgeronde timmerprojecten van Willemstein Timmerwerken."
>
	<section class="page-intro">
		<p class="eyebrow">Projecten</p>
		<h1>Voorbeelden van recent timmerwerk</h1>
		<p>
			Per project zie je wat er is uitgevoerd en hoe het eindresultaat eruitziet. Zo krijg je een
			goed beeld van stijl en afwerking.
		</p>
	</section>

	<section class="grid-3 section">
		{projects.map((project) => (
			<a
				class="project-card reveal"
				href={`/projecten/${projectSlug(project.id)}`}
				aria-label={`Lees project ${project.data.title}`}
			>
				<Image
					src={project.data.cover}
					alt={project.data.title}
					loading="lazy"
					width={Math.min(project.data.cover.width, 720)}
				/>
				<div>
					<h2>{project.data.title}</h2>
					<p>{project.data.excerpt}</p>
					<p>{project.data.region} · {project.data.year}</p>
					<span class="project-card-cta">Lees project</span>
				</div>
			</a>
		))}
	</section>
</BaseLayout>