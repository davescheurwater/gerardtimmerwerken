---
import BaseLayout from '../layouts/BaseLayout.astro';
import { emailJsConfig } from '../data/emailjs';
import { siteConfig } from '../data/site';
import { services } from '../data/services';
---

<BaseLayout
	title="Offerte aanvragen | Willemstein Timmerwerken"
	description="Vraag vrijblijvend een offerte aan bij Willemstein Timmerwerken."
>
	<section class="page-intro">
		<p class="eyebrow">Offerte</p>
		<h1>Vraag een vrijblijvende offerte aan</h1>
		<p>
			Vul je gegevens in en beschrijf je klus zo duidelijk mogelijk. Dan kan ik snel een passende
			inschatting maken.
		</p>
	</section>

	<section class="section">
		<article class="info-block reveal">
			<form
				class="offerte-form"
				method="POST"
				enctype="multipart/form-data"
				data-emailjs-form
				data-emailjs-service-id={emailJsConfig.serviceId}
				data-emailjs-template-id={emailJsConfig.templateId}
				data-emailjs-public-key={emailJsConfig.publicKey}
				data-emailjs-success-redirect="/bedankt"
			>
				<input type="hidden" name="formulier_type" value="Offerteformulier" />
				<input type="hidden" name="onderwerp" value="Nieuwe offerteaanvraag - Willemstein Timmerwerken" />
				<input type="hidden" name="to_email" value={siteConfig.email} />
				<label>
					Naam
					<input type="text" name="naam" required />
				</label>
				<label>
					E-mail
					<input type="email" name="email" required />
				</label>
				<label>
					Telefoon
					<input type="tel" name="telefoon" required />
				</label>
				<label>
					Postcode / Plaats
					<input type="text" name="regio" required />
				</label>
				<label>
					Type klus
					<select name="type_klus" required>
						<option value="">Kies een dienst</option>
						{services.map((service) => <option value={service.title}>{service.title}</option>)}
						<option value="Overig">Overig</option>
					</select>
				</label>
				<label>
					Gewenste startperiode
					<input type="text" name="startperiode" placeholder="Bijv. mei-juni 2026" />
				</label>
				<label>
					Indicatiebudget (optioneel)
					<input type="text" name="budget" placeholder="Bijv. €2.500 - €5.000" />
				</label>
				<label>
					Omschrijving klus
					<textarea name="bericht" rows="6" required></textarea>
				</label>
				<label>
					Foto/bestand toevoegen (optioneel)
					<input type="file" name="bijlage" />
				</label>
				<label>
					<input type="checkbox" name="privacy_akkoord" required />
					Ik ga akkoord met de verwerking van mijn gegevens volgens de privacyverklaring.
				</label>
				<p class="form-status" data-form-status aria-live="polite"></p>
				<button class="btn" type="submit">Offerte versturen</button>
			</form>
		</article>
	</section>
</BaseLayout>

<script>
	import '../scripts/emailjs-form';
</script>